{
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/debug-login",
      "dest": "/api/debug-login.ts"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login.ts"
    },
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/boot.ts"
    },
    {
      "src": "/api/trpc",
      "dest": "/api/boot.ts"
    },
    {
      "src": "/api/auth/register",
      "dest": "/api/auth/register.ts"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}